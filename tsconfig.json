{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Test chạy thẳng bằng `node --test --experimental-strip-types`, và ESM
    // của Node đòi phần mở rộng tường minh trong đường dẫn import. Bật cờ này
    // để `./spend.ts` vừa chạy được vừa CÒN được tsc kiểm — cách kia là đẩy
    // test ra ngoài `include` như `scripts/`, tức đánh đổi kiểm kiểu lấy chỗ
    // đặt file. An toàn vì `noEmit` đã bật: không có bundle nào phải giải
    // đường dẫn này.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // scripts/ runs standalone under tsx, outside the bundler's module
  // resolution, so its explicit ".ts" import specifiers fail Next's type
  // check even though the script itself is fine.
  "exclude": ["node_modules", "scripts"]
}
