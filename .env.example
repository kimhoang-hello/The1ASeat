# Contentful (optional). When both are set, the site fetches live content
# from Contentful instead of the local sample data in content/sample/.
# See CONTENTFUL.md for the content model to create in your space.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# The site's base URL is NOT an environment variable — it is the SITE_URL
# constant in src/lib/subscriber-email.ts. It feeds canonicals, the sitemap and
# the JSON-LD @ids, so it lives in the repo where a change is reviewable rather
# than in a hosting panel where a typo would silently rewrite all of them.

# Kit (ConvertKit) — powers the newsletter signup form. Without these, the
# form's submit request will fail with a "not_configured" server error.
# Get both from your Kit account: API Key under Settings > Developer, and
# the Form ID from the form's edit URL (app.kit.com/forms/designers/<id>/edit).
KIT_API_KEY=
KIT_FORM_ID=

# Contentful publish webhook -> /api/revalidate (optional, see CONTENTFUL.md
# "Auto-refresh on publish"). Without these, published content still goes
# live on the next code deploy or manual Hostinger cache clear, just not
# instantly.
REVALIDATE_SECRET=
HOSTINGER_API_TOKEN=
HOSTINGER_USERNAME=
HOSTINGER_DOMAIN=ghe1a.com

# Resend — sends the welcome email to each new newsletter subscriber, from
# info@ghe1a.com. Without this, subscribing still works, just no welcome
# email is sent. See CONTENTFUL.md "Email chào mừng cho subscriber mới".
RESEND_API_KEY=

# Cusdis — powers the comment section under blog posts/videos. Sign up free
# at cusdis.com, add a project with your site's domain, and copy its App ID
# here. Without this, the comment section simply doesn't render.
NEXT_PUBLIC_CUSDIS_APP_ID=

# Google Analytics 4 — Measurement ID from analytics.google.com (Admin > Data
# Streams > your web stream). Without this, no analytics script loads at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console site verification. In Search Console pick the URL-prefix
# property https://ghe1a.com, choose the "HTML tag" method, and paste only the
# content="..." value here (not the whole <meta> tag). Without this the site
# still gets crawled — you just can't see or submit anything in Search Console.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Scheduled jobs (GitHub Actions). Where each of these ALSO has to exist on the
# GitHub side differs per variable, so don't assume "repo secret" for all of
# them (checked 09/09/2026):
#
#   EXPIRE_OFFERS_SECRET, SYNC_VIDEOS_SECRET  repo secret — the workflow sends
#                                             it as an Authorization: Bearer
#                                             header to a route on the site.
#   CONTENTFUL_SPACE_ID / _ACCESS_TOKEN /     `contentful-write` environment,
#   _MANAGEMENT_TOKEN                         restricted to branch main —
#                                             check-rebates runs in the runner
#                                             and talks to Contentful directly.
#   ANTHROPIC_API_KEY, KIT_V4_API_KEY         server only. No workflow reads
#                                             them.
#
# DEPLOY.md has the same table; CONTENTFUL.md has the full setup.
# ---------------------------------------------------------------------------

# Contentful Content Management token, shared by every job that writes back to
# Contentful (video sync, offer expiry, rebate checks).
#
# Since 09/09/2026 this token also lives on the GitHub side: check-rebates runs
# inside the Actions runner instead of calling the site, because Hostinger's
# edge blocks runner IPs. It is NOT a repo secret — it sits in the
# `contentful-write` environment, which only branch `main` may use. See
# AGENTS.md and scripts/check-rebates.mts.
CONTENTFUL_MANAGEMENT_TOKEN=

# Guards /api/sync-videos, which polls the YouTube RSS feed and creates a
# blogPost for any new video.
SYNC_VIDEOS_SECRET=

# Guards THREE routes: /api/expire-offers (moves cards off the elevated tab once
# their offer ends), /api/offer-snapshot (read side of the offer-history job),
# and /api/check-rebates (manual runs only — its scheduled run no longer goes
# through the site).
EXPIRE_OFFERS_SECRET=

# Lets /api/expire-offers rewrite a card's Vietnamese copy from FinlyWealth's
# current numbers when its elevated offer ends. Without it the card still moves
# tabs, it just keeps the old copy and is reported in `needsReview`.
ANTHROPIC_API_KEY=

# Kit v4 API key, used to broadcast a new post to subscribers from
# /api/revalidate. Separate from KIT_API_KEY above, which is the v3 key the
# signup form uses.
KIT_V4_API_KEY=
