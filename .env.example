# Contentful (optional). When both are set, the site fetches live content
# from Contentful instead of the local sample data in content/sample/.
# See CONTENTFUL.md for the content model to create in your space.
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Base URL used for metadata/canonical links and sitemap generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
